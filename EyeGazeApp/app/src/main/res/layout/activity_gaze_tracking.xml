<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Camera Preview (Toggleable) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25" />

    <!-- Fullscreen Gaze Overlay (Cursor, Trail, Dwell Targets) -->
    <com.example.eyegaze.ui.view.GazeOverlayView
        android:id="@+id/gazeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Real-time HUD Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#D91E293B"
        app:cardCornerRadius="16dp"
        app:strokeColor="#3300E5FF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEngineBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2600E5FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Qualcomm EyeNet"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvFpsLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FPS: 30 | 12 ms"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvGazeCoords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="視線點位: X: 540, Y: 960"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAngles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pitch: 0.12  Yaw: -0.05"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls Floating Bar -->
    <HorizontalScrollView
        android:id="@+id/bottomScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D91E293B"
            android:padding="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSensitivity"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="靈敏度: 1.35x"
                style="@style/Widget.Material3.Button.TonalButton"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSmooth"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="平滑: 高 (穩定)"
                style="@style/Widget.Material3.Button.TonalButton"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTrail"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="軌跡"
                style="@style/Widget.Material3.Button.TonalButton"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleCamera"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="相機"
                style="@style/Widget.Material3.Button.TonalButton"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecalibrate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="重校準"
                android:textColor="@color/black"
                app:backgroundTint="@color/primary"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="返回"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:textSize="11sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
